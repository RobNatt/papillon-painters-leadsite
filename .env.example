# Copy to .env.local for development; set the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://papillionpainters.com

# Resend (https://resend.com): API key, a verified sender on papillionpainters.com, and where leads go (comma-separated)
RESEND_API_KEY=
EMAIL_FROM="Papillion Painters <quotes@papillionpainters.com>"
LEAD_TO_EMAIL=

# Form endpoint: every lead (quote, estimate, painter inquiry) is POSTed here as JSON,
# e.g. a CRM or automation webhook. Resend email still goes out too when configured.
FORM_ENDPOINT_URL=

# Painter "Book a call" link (defaults to the N-Tech booking calendar)
NEXT_PUBLIC_BOOKING_URL=https://calendar.ntechdigitalsolutions.com/widget/booking/hWquGYSIsA9rDZFT0PAF

# Contact address shown on the privacy page
NEXT_PUBLIC_CONTACT_EMAIL=hello@papillionpainters.com
